# PostgreSQL — shared server, schemas `fastvc` and `fastvc_rag` will be
# created inside the target database.
DB_URL=postgresql://user:pass@host:5432/dbname

# xAI Grok (OpenAI-compatible endpoint)
XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-reasoning
XAI_AGENT_MODEL=grok-4

# Web search for sourcing agents. Tavily is the default; EXA is fallback.
TAVILY_API_KEY=tvly-...
EXA_API_KEY=

# Embeddings. Default is `local` (fastembed, no API key, ~100 MB ONNX model).
# Switch to `openai` if you have OPENAI_API_KEY and want higher-quality vectors.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
OPENAI_API_KEY=

# Email (Postmark)
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=
FROM_EMAIL=
FROM_NAME=FastVC

# Daily deals digest scheduler
DIGEST_ENABLED=1        # set to 0 to disable the daemon thread
DIGEST_HOUR=7           # hour (EET) to send the daily digest
DAILY_DEALS_TO_EMAIL=   # legacy single-recipient override (optional)

# App
APP_ENV=dev
APP_SECRET=change-me
PORT=5059
SERVICE_URL=http://localhost:5059
FASTVC_CONTACT_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional global integration credentials. Users can instead configure masked,
# encrypted per-user keys from /app/integrations (recommended).
AFFINITY_API_KEY=
ATTIO_API_KEY=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
BREVO_API_KEY=
